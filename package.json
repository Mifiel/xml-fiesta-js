{
  "name": "xml-fiesta",
  "version": "1.8.1",
  "description": "Electronic signed document XML Protocol for Node & Browser",
  "main": "./lib/xml-fiesta.js",
  "types": "./lib/xml-fiesta.d.ts",
  "scripts": {
    "test": "NODE_OPTIONS='--require ./scripts/esbuild-register.cjs' mocha",
    "test:watch": "NODE_OPTIONS='--require ./scripts/esbuild-register.cjs' mocha --watch --watch-files src --watch-files spec",
    "coverage": "NODE_OPTIONS='-r ./scripts/nyc-cpus-polyfill.cjs' nyc pnpm test",
    "tslint": "tslint -c tslint.json -p tsconfig.json",
    "build": "rimraf lib dist && tsc && node ./scripts/build-browser.mjs && node ./scripts/sync-types-package.mjs",
    "prepublishOnly": "pnpm run build",
    "postpublish": "(cd xml-fiesta-types && pnpm publish --access public --no-git-checks)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mifiel/xml-fiesta-js.git"
  },
  "keywords": [
    "Electronic",
    "document",
    "electronic",
    "signatures",
    "resa",
    "xml",
    "pdf2xml"
  ],
  "author": "Genaro Madrid <genmadrid@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mifiel/xml-fiesta-js/issues"
  },
  "homepage": "https://github.com/Mifiel/xml-fiesta-js#readme",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "^26.6.4",
    "@types/node-forge": "1.3.14",
    "@types/xml2js": "0.4.14",
    "chai": "6.3.0",
    "esbuild": "0.28.2",
    "esbuild-plugins-node-modules-polyfill": "1.8.3",
    "events": "3.3.0",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "node-forge": "1.4.0",
    "xml2js": "0.6.2",
    "xpath.js": "1.1.0"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "include": "src/**",
    "reporter": [
      "html",
      "text",
      "lcov"
    ],
    "all": true
  }
}
