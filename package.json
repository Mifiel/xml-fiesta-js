{
  "name": "xml-fiesta",
  "version": "1.8.1",
  "description": "Electronic signed document XML Protocol for Node & Browser",
  "main": "./lib/xml-fiesta.js",
  "types": "./lib/xml-fiesta.d.ts",
  "scripts": {
    "test": "mocha",
    "test:watch": "mocha --watch --watch-files src --watch-files spec",
    "coverage": "node -r ./scripts/nyc-cpus-polyfill.cjs ./node_modules/nyc/bin/nyc.js npm test",
    "tslint": "tslint -c tslint.json -p tsconfig.json",
    "build": "rimraf lib dist && tsc && node ./scripts/build-browser.mjs && node ./scripts/sync-types-package.mjs",
    "prepublishOnly": "npm run build",
    "postpublish": "(cd xml-fiesta-types && npm publish)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mifiel/xml-fiesta-js.git"
  },
  "keywords": [
    "Electronic",
    "document",
    "electronic",
    "signatures",
    "resa",
    "xml",
    "pdf2xml"
  ],
  "author": "Genaro Madrid <genmadrid@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mifiel/xml-fiesta-js/issues"
  },
  "homepage": "https://github.com/Mifiel/xml-fiesta-js#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "^18.0",
    "@types/node-forge": "1.3.14",
    "@types/xml2js": "0.4.14",
    "chai": "6.2.2",
    "esbuild": "0.27.0",
    "esbuild-plugins-node-modules-polyfill": "1.8.1",
    "events": "3.3.0",
    "mocha": "11.7.5",
    "nyc": "18.0.0",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "node-forge": "1.4.0",
    "xml2js": "0.6.2",
    "xmldom": "0.6.0",
    "xpath.js": "1.1.0"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "include": "src/**",
    "reporter": [
      "html",
      "text",
      "lcov"
    ],
    "all": true
  },
  "volta": {
    "node": "22.21.1",
    "yarn": "1.22.22"
  }
}
