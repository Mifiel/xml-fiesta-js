{
  "name": "xml-fiesta",
  "version": "1.8.0",
  "description": "Electronic signed document XML Protocol for Node & Browser",
  "main": "./lib/xml-fiesta.js",
  "types": "./lib/xml-fiesta.d.ts",
  "scripts": {
    "test": "mocha",
    "test:watch": "mocha --watch --watch-files src --watch-files spec",
    "coverage": "node -r ./scripts/nyc-cpus-polyfill.cjs ./node_modules/nyc/bin/nyc.js npm test",
    "tslint": "tslint -c tslint.json -p tsconfig.json",
    "build": "rimraf lib dist && tsc && node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && browserify lib/xml-fiesta.js --standalone XMLFiesta -o dist/xml-fiesta.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mifiel/xml-fiesta-js.git"
  },
  "keywords": [
    "Electronic",
    "document",
    "electronic",
    "signatures",
    "resa",
    "xml",
    "pdf2xml"
  ],
  "author": "Genaro Madrid <genmadrid@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mifiel/xml-fiesta-js/issues"
  },
  "homepage": "https://github.com/Mifiel/xml-fiesta-js#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "25.5.0",
    "@types/node-forge": "1.3.14",
    "@types/xml2js": "0.4.14",
    "browserify": "17.0.1",
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "nyc": "18.0.0",
    "rimraf": "6.1.3",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "typescript": "6.0.2",
    "uglify-js": "3.19.3"
  },
  "dependencies": {
    "node-forge": "1.4.0",
    "promise": "8.3.0",
    "xml-crypto": "6.1.2",
    "xml2js": "0.6.2",
    "xmldom": "0.6.0",
    "xpath.js": "1.1.0"
  },
  "resolutions": {
    "diff": "5.2.0"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "include": "src/**",
    "reporter": [
      "html",
      "text",
      "lcov"
    ],
    "all": true
  },
  "volta": {
    "node": "22.21.1",
    "yarn": "1.22.22"
  }
}
